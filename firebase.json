{
  "hosting": {
    "public": "apps/web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": { "serviceId": "memecoin-os-api", "region": "europe-west1" }
      },
      {
        "source": "/v2/**",
        "run": { "serviceId": "memecoin-os-api", "region": "europe-west1" }
      },
      {
        "source": "/health",
        "run": { "serviceId": "memecoin-os-api", "region": "europe-west1" }
      },
      {
        "source": "/tokens/**",
        "destination": "/tokens/pepe/index.html"
      },
      {
        "source": "/twin/**",
        "destination": "/twin/pepe/index.html"
      },
      {
        "source": "/embed/**",
        "destination": "/embed/pepe/index.html"
      },
      {
        "source": "/projects/**",
        "destination": "/projects/pepe/index.html"
      }
    ]
  }
}
