# MemeCoin OS — copy to .env and adjust.
API_HOST=127.0.0.1
API_PORT=8080
RUST_LOG=info,memecoin_os_api=debug,memecoin_os_core=debug

TOKEN_REGISTRY_PATH=tokens
DATA_MODE=live
TOKEN_REFRESH_PER_HOUR=12

# Host ports 5435/6381 avoid clashing with other local stacks.
DATABASE_URL=postgres://memecoin:memecoin@127.0.0.1:5435/memecoin_os
REDIS_URL=redis://127.0.0.1:6381

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
DEXSCREENER_BASE_URL=https://api.dexscreener.com
FEATURE_COINGECKO=true
FEATURE_DEXSCREENER=true
FEATURE_GITHUB=true
FEATURE_HOLDERS=true

# Optional. Without it, Ethereum holders still try Ethplorer (freekey).
ETHERSCAN_API_KEY=
ETHPLORER_API_KEY=freekey

# When true, /v1/* requires Authorization: Bearer mcos_…
AUTH_REQUIRED=false

# Optional. Never set from an AI prompt. Enables the ERC-20 transfer cursor.
FEATURE_ONCHAIN_INDEXER=true
INDEXER_BLOCK_SPAN=200
INDEXER_CONFIRMATIONS=6
RPC_ETHEREUM=
RPC_ARBITRUM=
RPC_BSC=

FEATURE_AI_RESEARCH=true
# NVIDIA Build catalog (OpenAI-compatible). Never paste the key into a prompt.
# Free tier is rate-limited (~40 req/min), not a production SLA.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4-pro-0813,moonshotai/kimi-k3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Metering records usage always. Quotas return 402 only when true. No Stripe.
METERING_ENFORCE=false

# Content-addressed snapshots. Written only if flag jobs.raw_store is on.
OBJECT_STORE_PATH=data/raw

# OIDC / Google Sign-In. All three required or SSO stays unconfigured (no fake users).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web).
# Authorized redirect URI (exact):
#   https://memecoin-os.web.app/v1/auth/oidc/callback
#   http://127.0.0.1:8080/v1/auth/oidc/callback  (local)
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://memecoin-os.web.app/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile

# Discord click-to-connect (OAuth2 scope webhook.incoming). Never paste secrets into chat.
# Redirect URI: https://memecoin-os.web.app/v1/connect/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Telegram click-to-connect. Create a bot with BotFather. Never paste the token into chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# Firebase Hosting project memecoin-os (client keys in apps/web/.env.local — not committed)
# Webhook (when API is public): https://memecoin-os.web.app/v1/billing/stripe/webhook
STRIPE_ACCOUNT_ID=acct_1TQsIIGT8Pzxsiro
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids from Stripe Products (price_…). Webhook maps these onto PlanId.
STRIPE_PRICE_PRO=
STRIPE_PRICE_RESEARCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_API=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=memecoin-os
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=memecoin-os.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=memecoin-os.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=763598651987
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
